{
  "expo": {
    "name": "majan-score-table",
    "slug": "majan-score-table",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "majanscoretable",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d3a2a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emtc.mahjongscore",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "5"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.mahjongscore.app",
      "permissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "react-native-iap",
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-2989531368920692~2249274871"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "広告をあなたの興味に合わせるために使用されます。"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4cdc021d-8b00-4726-b101-445e8fa31728"
      }
    },
    "owner": "emtcdv"
  }
}
